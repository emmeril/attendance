PORT=3000
NODE_ENV=development
APP_NAME=HadirKu
APP_URL=http://localhost:3000
SESSION_SECRET=ganti-dengan-random-string-yang-panjang
DATA_ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-yang-berbeda
DB_PATH=./data/attendance.db
TIMEZONE=Asia/Jakarta

# Sinkronisasi otomatis mesin TCP (minimum interval 30 detik)
MACHINE_AUTO_SYNC=true
MACHINE_SYNC_INTERVAL_SECONDS=300
MACHINE_SYNC_INITIAL_DELAY_SECONDS=10

# Akun awal (hanya dipakai saat database masih kosong)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=admin123

# Integrasi Solution Cloud / REST API Solution Finger
# Isi base URL dan path sesuai dokumentasi API akun Anda.
SOLUTION_BASE_URL=https://www.solutioncloud.co.id
SOLUTION_API_KEY=
SOLUTION_API_SECRET=
SOLUTION_AUTH_HEADER=Authorization
SOLUTION_AUTH_SCHEME=Bearer
SOLUTION_DEVICES_PATH=/api/devices
SOLUTION_ATTENDANCE_PATH=/api/attendance
SOLUTION_TIMEOUT_MS=20000
SOLUTION_WEBHOOK_SECRET=ganti-secret-webhook
SOLUTION_VERIFY_TLS=true
# ADMS menerima push langsung dari mesin. Untuk jaringan lain, gunakan IP/domain publik.
SOLUTION_ADMS_AUTO_REGISTER=true
